{% extends 'admin/base.html.twig' %}
{% block title %}Gestion des cartes — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-stack me-2"></i>Cartes ({{ total }})</h2>
    <a href="{{ path('app_admin_carte_new') }}" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>Nouvelle carte
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="GET" class="row g-2 align-items-end">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" class="form-control" placeholder="Rechercher une carte…" value="{{ filters.search }}">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Image</th><th>Nom</th><th>Série</th><th>Type</th><th>Rareté</th>
                    <th class="text-center">Prix</th><th class="text-center">Stock</th><th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for carte in cartes %}
                <tr>
                    <td><img src="{{ asset('uploads/cards/' ~ carte.image) }}" width="45" height="45" style="object-fit:contain" onerror="this.onerror=null;this.src='/images/placeholder.svg'"></td>
                    <td class="fw-semibold">
                        <a href="{{ path('app_carte_show', {id: carte.id}) }}" target="_blank" class="text-dark text-decoration-none">{{ carte.nom }}</a>
                    </td>
                    <td class="text-muted small">{{ carte.serie ? carte.serie.nom : '—' }}</td>
                    <td><span class="type-badge type-{{ carte.typePokemon }}">{{ carte.typePokemon }}</span></td>
                    <td><span class="badge bg-secondary">{{ carte.rarete }}</span></td>
                    <td class="text-center fw-bold">{{ carte.prix|number_format(2, ',', ' ') }} €</td>
                    <td class="text-center">
                        <span class="badge {% if carte.stock > 5 %}bg-success{% elseif carte.stock > 0 %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                            {{ carte.stock }}
                        </span>
                    </td>
                    <td class="text-center">
                        <a href="{{ path('app_admin_carte_edit', {id: carte.id}) }}" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="POST" action="{{ path('app_admin_carte_delete', {id: carte.id}) }}" class="d-inline"
                              onsubmit="return confirm('Supprimer {{ carte.nom }} ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_carte_' ~ carte.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="8" class="text-center text-muted py-4">Aucune carte trouvée.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if pages > 1 %}
<nav class="mt-3">
    <ul class="pagination justify-content-center">
        {% for p in range(1, pages) %}
        <li class="page-item {{ p == page ? 'active' : '' }}">
            <a class="page-link" href="?page={{ p }}&search={{ filters.search }}">{{ p }}</a>
        </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
{% endblock %}
