{% extends 'admin/base.html.twig' %}
{% block title %}Commandes — Admin{% endblock %}

{% block admin_content %}
<h2 class="fw-bold mb-4"><i class="bi bi-bag me-2"></i>Commandes ({{ total }})</h2>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="GET" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="reference" class="form-control form-control-sm" placeholder="Référence…" value="{{ filters.reference }}">
            </div>
            <div class="col-md-3">
                <input type="email" name="email" class="form-control form-control-sm" placeholder="Email client…" value="{{ filters.email }}">
            </div>
            <div class="col-md-3">
                <select name="statut" class="form-select form-select-sm">
                    <option value="">Tous les statuts</option>
                    {% for s in statuts %}
                    <option value="{{ s }}" {{ filters.statut == s ? 'selected' : '' }}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Filtrer</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr><th>Référence</th><th>Client</th><th>Date</th><th>Total</th><th>Statut</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                <tr>
                    <td class="fw-bold text-danger">{{ commande.reference }}</td>
                    <td>
                        <div class="fw-semibold">{{ commande.clientNom }}</div>
                        <div class="small text-muted">{{ commande.clientEmail }}</div>
                    </td>
                    <td class="small">{{ commande.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="fw-bold">{{ commande.total|number_format(2, ',', ' ') }} €</td>
                    <td>
                        <select class="form-select form-select-sm statut-select" data-id="{{ commande.id }}" style="max-width:160px">
                            {% for s in statuts %}
                            <option value="{{ s }}" {{ commande.statut == s ? 'selected' : '' }}>{{ s }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td>
                        <a href="{{ path('app_admin_commande_show', {id: commande.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center text-muted py-4">Aucune commande.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('.statut-select').forEach(sel => {
    sel.addEventListener('change', async function() {
        const id = this.dataset.id;
        const fd = new FormData(); fd.append('statut', this.value);
        const res = await fetch(`/admin/commandes/${id}/statut`, { method: 'POST', body: fd });
        const data = await res.json();
        if (!data.success) { alert('Erreur'); this.value = this.dataset.original; }
    });
    sel.dataset.original = sel.value;
});
</script>
{% endblock %}
