{% extends 'admin/base.html.twig' %}
{% block title %}{{ titre }} — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="{{ path('app_admin_serie_index') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h2 class="fw-bold mb-0">{{ titre }}</h2>
</div>
<div class="card shadow-sm" style="max-width:600px">
    <div class="card-body">
        {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.annee) }}
        {{ form_row(form.description) }}
        {{ form_row(form.imageFile) }}
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-success"><i class="bi bi-save me-1"></i>Enregistrer</button>
            <a href="{{ path('app_admin_serie_index') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
