{% extends 'base.html.twig' %}

{% block body %}
<div class="container-fluid py-3">
    <div class="row g-0">
        {# Sidebar #}
        <div class="col-md-2">
            <div class="card shadow-sm h-100" style="min-height:80vh">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-speedometer2 me-2"></i>Admin
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('app_admin_dashboard') }}" class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}">
                        <i class="bi bi-grid me-2"></i>Tableau de bord
                    </a>
                    <a href="{{ path('app_admin_carte_index') }}" class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') starts with 'app_admin_carte' ? 'active' : '' }}">
                        <i class="bi bi-stack me-2"></i>Cartes
                    </a>
                    <a href="{{ path('app_admin_serie_index') }}" class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') starts with 'app_admin_serie' ? 'active' : '' }}">
                        <i class="bi bi-collection me-2"></i>Séries
                    </a>
                    <a href="{{ path('app_admin_commande_index') }}" class="list-group-item list-group-item-action {{ app.request.attributes.get('_route') starts with 'app_admin_commande' ? 'active' : '' }}">
                        <i class="bi bi-bag me-2"></i>Commandes
                    </a>
                    <hr class="my-1">
                    <a href="{{ path('app_home') }}" class="list-group-item list-group-item-action">
                        <i class="bi bi-shop me-2"></i>Voir le site
                    </a>
                </div>
            </div>
        </div>
        {# Contenu #}
        <div class="col-md-10 ps-3">
            {% block admin_content %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
