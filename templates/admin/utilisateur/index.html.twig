{% extends 'admin/base.html.twig' %}
{% block title %}Utilisateurs — Admin{% endblock %}

{% block admin_content %}
<h2 class="fw-bold mb-4"><i class="bi bi-people me-2"></i>Utilisateurs ({{ total }})</h2>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="GET" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control form-control-sm"
                       placeholder="Nom, prénom, email…" value="{{ filters.search }}">
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select form-select-sm">
                    <option value="">Tous les rôles</option>
                    <option value="ROLE_ADMIN" {{ filters.role == 'ROLE_ADMIN' ? 'selected' : '' }}>Administrateur</option>
                    <option value="ROLE_USER"  {{ filters.role == 'ROLE_USER'  ? 'selected' : '' }}>Client</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i></button>
                <a href="{{ path('app_admin_utilisateur_index') }}" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nom</th><th>Email</th><th>Rôle</th><th>Statut</th><th>Inscription</th>
                </tr>
            </thead>
            <tbody>
                {% for u in utilisateurs %}
                <tr>
                    <td class="fw-semibold">{{ u.nomComplet }}</td>
                    <td>{{ u.email }}</td>
                    <td>
                        {% if u.isAdmin %}
                            <span class="badge bg-danger">Admin</span>
                        {% else %}
                            <span class="badge bg-secondary">Client</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if u.actif %}
                            <span class="badge bg-success">Actif</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">Inactif</span>
                        {% endif %}
                    </td>
                    <td class="text-muted small">{{ u.createdAt|date('d/m/Y') }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">Aucun utilisateur trouvé.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if pages > 1 %}
<nav class="mt-3">
    <ul class="pagination pagination-sm justify-content-center">
        {% for p in 1..pages %}
        <li class="page-item {{ p == page ? 'active' : '' }}">
            <a class="page-link" href="{{ path('app_admin_utilisateur_index', filters|merge({page: p})) }}">{{ p }}</a>
        </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
{% endblock %}
