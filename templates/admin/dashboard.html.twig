{% extends 'admin/base.html.twig' %}
{% block title %}Dashboard Admin — PokéShop{% endblock %}

{% block admin_content %}
<h2 class="fw-bold mb-4"><i class="bi bi-speedometer2 me-2"></i>Tableau de bord</h2>

{# KPIs #}
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-danger text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div><div class="fs-4 fw-bold">{{ nbCartes }}</div><div>Cartes au catalogue</div></div>
                    <i class="bi bi-stack display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div><div class="fs-4 fw-bold">{{ nbCommandesEnAttente }}</div><div>Commandes en attente</div></div>
                    <i class="bi bi-hourglass-split display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    {% set totalCA = 0 %}
    {% for s in statsCommandes %}{% if s._id != 'Annulée' %}{% set totalCA = totalCA + s.total %}{% endif %}{% endfor %}
    <div class="col-md-3">
        <div class="card bg-success text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div><div class="fs-4 fw-bold">{{ totalCA|number_format(0, ',', ' ') }} €</div><div>CA total</div></div>
                    <i class="bi bi-currency-euro display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="fs-4 fw-bold">{{ statsTypes|length }}</div>
                        <div>Types de cartes</div>
                    </div>
                    <i class="bi bi-lightning display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    {# Stats par statut commandes #}
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold"><i class="bi bi-pie-chart me-2"></i>Commandes par statut</div>
            <div class="card-body">
                {% for stat in statsCommandes %}
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge
                        {% if stat._id == 'En attente' %}bg-warning text-dark
                        {% elseif stat._id == 'Livrée' %}bg-success
                        {% elseif stat._id == 'Annulée' %}bg-danger
                        {% else %}bg-primary{% endif %}">
                        {{ stat._id }}
                    </span>
                    <div class="fw-bold">{{ stat.count }} ({{ stat.total|number_format(2, ',', ' ') }} €)</div>
                </div>
                {% else %}
                <p class="text-muted">Aucune commande.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Stats cartes par type (Map Reduce via agrégation) #}
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold"><i class="bi bi-bar-chart me-2"></i>CA potentiel par type (Agrégation)</div>
            <div class="card-body" style="max-height:300px;overflow-y:auto">
                {% for stat in caPotentiel %}
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="type-badge type-{{ stat._id }}">{{ stat._id }}</span>
                    <div>
                        <span class="fw-bold">{{ stat.caTotalPotentiel|number_format(2, ',', ' ') }} €</span>
                        <small class="text-muted ms-2">{{ stat.nbCartes }} cartes</small>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# CA par mois #}
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold"><i class="bi bi-graph-up me-2"></i>CA par mois</div>
            <div class="card-body" style="max-height:250px;overflow-y:auto">
                {% for stat in caParMois %}
                <div class="d-flex justify-content-between mb-1">
                    <span>{{ stat._id.mois }}/{{ stat._id.annee }}</span>
                    <div>
                        <span class="fw-bold text-success">{{ stat.ca|number_format(2, ',', ' ') }} €</span>
                        <small class="text-muted ms-2">{{ stat.nbCommandes }} cmd</small>
                    </div>
                </div>
                {% else %}
                <p class="text-muted">Aucune donnée.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Distribution notes par rareté #}
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold"><i class="bi bi-star me-2"></i>Notes moyennes par rareté</div>
            <div class="card-body">
                {% for stat in notesParRarete %}
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span>{{ stat.rarete ?? stat._id }}</span>
                    <div>
                        {% set note = stat.notesMoyennes ?? 0 %}
                        {% for i in 1..5 %}
                        <i class="bi bi-star{% if i <= note %}-fill text-warning{% else %} text-muted{% endif %}"></i>
                        {% endfor %}
                        <small class="text-muted ms-1">({{ stat.nbAvis ?? 0 }} avis)</small>
                    </div>
                </div>
                {% else %}
                <p class="text-muted">Aucun avis.</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
