{% extends 'base.html.twig' %}
{% block title %}Mes commandes — PokéShop{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="fw-bold mb-4"><i class="bi bi-bag me-2"></i>Mes commandes</h1>
    {% if commandes|length > 0 %}
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Référence</th>
                        <th>Date</th>
                        <th>Articles</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for commande in commandes %}
                    <tr>
                        <td class="fw-bold text-danger">{{ commande.reference }}</td>
                        <td>{{ commande.createdAt|date('d/m/Y H:i') }}</td>
                        <td>{{ commande.nombreLignes }} article{{ commande.nombreLignes > 1 ? 's' : '' }}</td>
                        <td class="text-center fw-bold">{{ commande.total|number_format(2, ',', ' ') }} €</td>
                        <td class="text-center">
                            <span class="badge
                                {% if commande.statut == 'En attente' %}bg-warning text-dark
                                {% elseif commande.statut == 'Confirmée' %}bg-info
                                {% elseif commande.statut == 'Expédiée' %}bg-primary
                                {% elseif commande.statut == 'Livrée' %}bg-success
                                {% elseif commande.statut == 'Annulée' %}bg-danger
                                {% else %}bg-secondary{% endif %}">
                                {{ commande.statut }}
                            </span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% else %}
    <div class="text-center py-5">
        <i class="bi bi-bag-x display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">Aucune commande pour l'instant</h4>
        <a href="{{ path('app_carte_index') }}" class="btn btn-pokemon mt-3">Voir le catalogue</a>
    </div>
    {% endif %}
</div>
{% endblock %}
