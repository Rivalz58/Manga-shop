{% extends 'base.html.twig' %}
{% block title %}Catalogue — PokéShop{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row">

        {# Filtres latéraux #}
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white fw-bold">
                    <i class="bi bi-funnel me-2"></i>Filtres
                </div>
                <div class="card-body">
                    <form id="filterForm" method="GET">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Recherche</label>
                            <input type="text" name="search" class="form-control" value="{{ filters.search }}" placeholder="Nom de la carte…">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Type</label>
                            <select name="type" class="form-select">
                                <option value="">Tous les types</option>
                                {% for type in types %}
                                <option value="{{ type }}" {{ filters.type == type ? 'selected' : '' }}>{{ type }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Rareté</label>
                            <select name="rarete" class="form-select">
                                <option value="">Toutes les raretés</option>
                                {% for r in raretes %}
                                <option value="{{ r }}" {{ filters.rarete == r ? 'selected' : '' }}>{{ r }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Série</label>
                            <select name="serie" class="form-select">
                                <option value="">Toutes les séries</option>
                                {% for serie in series %}
                                <option value="{{ serie.id }}" {{ filters.serie == serie.id ? 'selected' : '' }}>{{ serie.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Prix (€)</label>
                            <div class="row g-1">
                                <div class="col"><input type="number" name="prix_min" class="form-control" placeholder="Min" value="{{ filters.prix_min }}" step="0.01" min="0"></div>
                                <div class="col"><input type="number" name="prix_max" class="form-control" placeholder="Max" value="{{ filters.prix_max }}" step="0.01" min="0"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" name="en_stock" value="1" class="form-check-input" id="enStock" {{ filters.en_stock ? 'checked' : '' }}>
                                <label class="form-check-label fw-semibold" for="enStock">En stock uniquement</label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-search me-1"></i>Filtrer
                        </button>
                        <a href="{{ path('app_carte_index') }}" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="bi bi-x me-1"></i>Réinitialiser
                        </a>
                    </form>
                </div>
            </div>
        </div>

        {# Liste des cartes #}
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-0">Catalogue</h2>
                    <small class="text-muted">{{ total }} carte{{ total > 1 ? 's' : '' }} trouvée{{ total > 1 ? 's' : '' }}</small>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <select id="sortSelect" class="form-select form-select-sm" style="width:auto" onchange="applySortFilter(this.value)">
                        <option value="nom-asc" {{ sort == 'nom' and order == 'asc' ? 'selected' : '' }}>Nom A→Z</option>
                        <option value="nom-desc" {{ sort == 'nom' and order == 'desc' ? 'selected' : '' }}>Nom Z→A</option>
                        <option value="prix-asc" {{ sort == 'prix' and order == 'asc' ? 'selected' : '' }}>Prix croissant</option>
                        <option value="prix-desc" {{ sort == 'prix' and order == 'desc' ? 'selected' : '' }}>Prix décroissant</option>
                        <option value="createdAt-desc" {{ sort == 'createdAt' and order == 'desc' ? 'selected' : '' }}>Nouveautés</option>
                    </select>
                </div>
            </div>

            {% if cartes|length > 0 %}
            <div class="row g-3" id="cartesGrid">
                {% for carte in cartes %}
                <div class="col-6 col-md-4">
                    {% include 'components/carte_card.html.twig' with {carte: carte} %}
                </div>
                {% endfor %}
            </div>

            {# Pagination #}
            {% if pages > 1 %}
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if page > 1 %}
                    <li class="page-item">
                        <a class="page-link" href="?{{ app.request.query.all|merge({'page': page - 1})|url_encode }}">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    {% endif %}
                    {% for p in range(max(1, page - 2), min(pages, page + 2)) %}
                    <li class="page-item {{ p == page ? 'active' : '' }}">
                        <a class="page-link" href="?{{ app.request.query.all|merge({'page': p})|url_encode }}">{{ p }}</a>
                    </li>
                    {% endfor %}
                    {% if page < pages %}
                    <li class="page-item">
                        <a class="page-link" href="?{{ app.request.query.all|merge({'page': page + 1})|url_encode }}">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    {% endif %}
                </ul>
            </nav>
            {% endif %}

            {% else %}
            <div class="text-center py-5">
                <i class="bi bi-search display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">Aucune carte trouvée</h4>
                <p class="text-muted">Essayez de modifier vos filtres.</p>
                <a href="{{ path('app_carte_index') }}" class="btn btn-danger">Voir tout le catalogue</a>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
function applySortFilter(value) {
    const [sort, order] = value.split('-');
    const url = new URL(window.location);
    url.searchParams.set('sort', sort);
    url.searchParams.set('order', order);
    url.searchParams.set('page', '1');
    window.location = url;
}
</script>
{% endblock %}
