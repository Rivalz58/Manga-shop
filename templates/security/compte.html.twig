{% extends 'base.html.twig' %}
{% block title %}Mon compte — PokéShop{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="fw-bold mb-4"><i class="bi bi-person-circle me-2"></i>Mon compte</h1>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm text-center p-4">
                <i class="bi bi-person-circle display-2 text-muted mb-3"></i>
                <h4 class="fw-bold">{{ user.nomComplet }}</h4>
                <p class="text-muted">{{ user.email }}</p>
                {% for role in user.roles %}
                <span class="badge bg-danger mb-1">{{ role }}</span>
                {% endfor %}
                <p class="small text-muted mt-2">Membre depuis le {{ user.createdAt|date('d/m/Y') }}</p>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header fw-bold"><i class="bi bi-info-circle me-2"></i>Mes informations</div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr><th>Prénom</th><td>{{ user.prenom }}</td></tr>
                        <tr><th>Nom</th><td>{{ user.nom }}</td></tr>
                        <tr><th>Email</th><td>{{ user.email }}</td></tr>
                        <tr><th>Adresse</th><td>{{ user.adresse ?: 'Non renseignée' }}</td></tr>
                        <tr><th>Téléphone</th><td>{{ user.telephone ?: 'Non renseigné' }}</td></tr>
                    </table>
                </div>
            </div>
            <a href="{{ path('app_commande_mes_commandes') }}" class="btn btn-danger mt-3">
                <i class="bi bi-bag me-2"></i>Voir mes commandes
            </a>
        </div>
    </div>
</div>
{% endblock %}
