<div class="card card-pokemon h-100">
    <a href="{{ path('app_carte_show', {id: carte.id}) }}">
        <img src="{{ asset('uploads/cards/' ~ carte.image) }}"
             onerror="this.onerror=null;this.src='/images/placeholder.svg'"
             alt="{{ carte.nom }}" class="card-img-top">
    </a>
    <div class="card-body d-flex flex-column p-3">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <h6 class="card-title mb-0 fw-bold">
                <a href="{{ path('app_carte_show', {id: carte.id}) }}" class="text-dark text-decoration-none">{{ carte.nom }}</a>
            </h6>
            <span class="type-badge type-{{ carte.typePokemon }}">{{ carte.typePokemon }}</span>
        </div>
        {% if carte.serie %}
        <div class="text-muted mb-1" style="font-size:.75rem">{{ carte.serie.nom }}</div>
        {% endif %}
        <div class="mb-2">
            <span class="badge
                {% if carte.rarete == 'Commune' %}bg-secondary
                {% elseif carte.rarete == 'Peu commune' %}bg-success
                {% elseif carte.rarete == 'Rare' %}bg-primary
                {% elseif carte.rarete == 'Ultra Rare' %}bg-purple
                {% else %}bg-danger{% endif %}"
                style="{% if carte.rarete == 'Ultra Rare' %}background:linear-gradient(135deg,#6f42c1,#e83e8c){% elseif carte.rarete == 'Secrète' %}background:linear-gradient(135deg,#f093fb,#f5576c){% endif %}">
                {{ carte.rarete }}
            </span>
        </div>
        <div class="mt-auto">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold fs-5" style="color:#CC0000">{{ carte.prix|number_format(2, ',', ' ') }} €</span>
                {% if carte.stock > 0 %}
                    <span class="badge bg-success small">En stock ({{ carte.stock }})</span>
                {% else %}
                    <span class="badge bg-danger small">Rupture</span>
                {% endif %}
            </div>
            {% if carte.stock > 0 %}
            <button class="btn btn-pokemon btn-sm w-100 mt-2 btn-ajouter-panier"
                    data-carte-id="{{ carte.id }}"
                    data-carte-nom="{{ carte.nom }}">
                <i class="bi bi-cart-plus me-1"></i> Ajouter
            </button>
            {% else %}
            <button class="btn btn-secondary btn-sm w-100 mt-2" disabled>
                <i class="bi bi-x-circle me-1"></i> Indisponible
            </button>
            {% endif %}
        </div>
    </div>
</div>

<script>
document.querySelectorAll('.btn-ajouter-panier').forEach(btn => {
    if (btn.dataset.initialized) return;
    btn.dataset.initialized = true;
    btn.addEventListener('click', async function() {
        const id = this.dataset.carteId;
        const nom = this.dataset.carteNom;
        this.disabled = true;
        try {
            const formData = new FormData();
            formData.append('quantite', 1);
            const res = await fetch(`/panier/ajouter/${id}`, { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
                updatePanierCount(data.nombreArticles);
                this.innerHTML = '<i class="bi bi-check me-1"></i> Ajouté !';
                this.classList.add('bg-success');
                setTimeout(() => {
                    this.innerHTML = '<i class="bi bi-cart-plus me-1"></i> Ajouter';
                    this.classList.remove('bg-success');
                    this.disabled = false;
                }, 1500);
            } else {
                alert(data.message);
                this.disabled = false;
            }
        } catch(e) { this.disabled = false; }
    });
});
</script>
